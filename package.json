{
  "name": "ledgr",
  "version": "0.11.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "pnpm build:mc-worker && next dev",
    "build": "pnpm build:mc-worker && next build",
    "build:mc-worker": "esbuild src/workers/monte-carlo-worker.ts --bundle --platform=node --format=cjs --outfile=monte-carlo-worker.js",
    "build:migrator": "esbuild db-migrate.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:pg-native --log-level=warning --outfile=db-migrate.js",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:typed": "eslint -c eslint.typed.config.mjs --no-inline-config --suppressions-location eslint-suppressions-typed.json --max-warnings 0 src",
    "format": "prettier --write .",
    "test": "vitest run --project='!benchmarks'",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/server/services/demo/dev-seed.ts",
    "test:coverage": "vitest run --coverage --project='!benchmarks'",
    "test:benchmarks": "vitest run --project=benchmarks",
    "test:tz": "LEDGR_TEST_TZ=America/Chicago vitest run --project='!benchmarks' tests/utils/date.test.ts tests/utils/date-keys.test.ts tests/pure/household/age.test.ts tests/pure/household/household-timeline.test.ts tests/pure/accounts/balance-dates.test.ts tests/pure/net-worth tests/pure/paycheck tests/config/pay-periods.test.ts tests/pure/sync/feed-data-date.test.ts tests/server/services/net-worth/year-end-history.test.ts",
    "test:year-end": "LEDGR_TEST_NOW=2025-12-31T23:30:00-06:00 pnpm -s test:tz && LEDGR_TEST_NOW=2026-01-01T00:30:00-06:00 pnpm -s test:tz",
    "test:stress": "FAST_CHECK_NUM_RUNS=200 vitest run tests/pure/engine/engine-invariants.test.ts tests/benchmarks/monte-carlo-properties.test.ts",
    "test:e2e": "playwright test",
    "engine-hash": "tsx scripts/engine-hash.ts",
    "check:engine-hash": "tsx scripts/engine-hash.ts --check",
    "docs:verify": "tsx scripts/verify-docs.ts && tsx scripts/calculations-tested.ts && pnpm docs:verify-api",
    "docs:update": "pnpm engine-hash && tsx scripts/verify-docs.ts --update && tsx scripts/calculations-tested.ts --update && pnpm docs:gen-api && npx prettier --write docs/SCHEMA.md docs/API_ROUTERS.md",
    "docs:gen-api": "tsx scripts/gen-api-docs.ts",
    "docs:verify-api": "pnpm docs:gen-api && npx prettier --write docs/SCHEMA.md docs/API_ROUTERS.md && git diff --exit-code docs/SCHEMA.md docs/API_ROUTERS.md || (echo \"docs/SCHEMA.md or docs/API_ROUTERS.md is stale — run 'pnpm docs:update' and commit the result.\" && exit 1)",
    "setup": "bash scripts/setup-dev.sh",
    "check:file-size": "tsx scripts/check-size-baseline.ts",
    "check:dead-code": "knip --no-progress",
    "check:dead-code:production": "knip --production --no-progress",
    "check:layers": "tsx scripts/check-layers.ts",
    "check:types-tests": "tsc -p tsconfig.tests.json",
    "check:types-scripts": "tsc -p tsconfig.scripts.json",
    "check:known-diffs": "tsx scripts/check-known-diffs.ts",
    "gate": "bash scripts/gate.sh",
    "check:batch": "bash scripts/check-batch.sh",
    "check:release": "bash scripts/check-release.sh",
    "release": "bash scripts/release.sh",
    "deploy": "bash scripts/deploy.sh",
    "analyze": "ANALYZE=true pnpm build",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:constraints": "tsx scripts/check-constraints.ts",
    "check:tax-params": "tsx scripts/check-tax-params.ts",
    "check:calculation-register": "tsx scripts/check-calculation-register.ts",
    "check:ratchets": "tsx scripts/check-ratchets.ts",
    "check:duplicates": "tsx scripts/check-duplicates.ts",
    "tax-data:keygen": "tsx scripts/tax-data-keygen.ts",
    "tax-data:publish": "tsx scripts/tax-data-publish.ts",
    "tax-data:check": "tsx scripts/tax-data-check.ts",
    "tax-data:new-year": "tsx scripts/tax-data-new-year.ts",
    "tax-data:schema": "tsx scripts/tax-data-schema.ts",
    "backup:export": "tsx scripts/export-backup.ts",
    "backup:import": "tsx scripts/import-backup.ts",
    "encryption:rotate": "tsx scripts/rotate-encryption-key.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.26.0",
    "@trpc/react-query": "^11.26.0",
    "@trpc/server": "^11.26.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "undici": "8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "flatted": ">=3.4.2",
      "minimatch@^10": "^11.0.1"
    }
  }
}
