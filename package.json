{
  "name": "ledgr",
  "version": "0.7.10",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm build:mc-worker && next dev",
    "build": "pnpm build:mc-worker && next build",
    "build:mc-worker": "esbuild src/workers/monte-carlo-worker.ts --bundle --platform=node --format=cjs --outfile=monte-carlo-worker.js",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project='!benchmarks'",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx .scratch/seed/seed.ts",
    "validate": "tsx .scratch/seed/validate.ts",
    "test:coverage": "vitest run --coverage --project='!benchmarks'",
    "test:benchmarks": "vitest run --project=benchmarks",
    "test:stress": "FAST_CHECK_NUM_RUNS=200 vitest run tests/calculators/engine-invariants.test.ts tests/benchmarks/monte-carlo-properties.test.ts",
    "test:e2e": "playwright test",
    "compare": "tsx .scratch/compare/compare-xlsx-to-live.ts",
    "seed:safe": "pnpm validate && pnpm seed && pnpm validate",
    "docs:verify": "tsx scripts/verify-docs.ts && pnpm docs:verify-api",
    "docs:update": "tsx scripts/verify-docs.ts --update && pnpm docs:gen-api && npx prettier --write docs/SCHEMA.md docs/API_ROUTERS.md",
    "docs:gen-api": "tsx scripts/gen-api-docs.ts",
    "docs:verify-api": "pnpm docs:gen-api && npx prettier --write docs/SCHEMA.md docs/API_ROUTERS.md && git diff --exit-code docs/SCHEMA.md docs/API_ROUTERS.md || (echo \"docs/SCHEMA.md or docs/API_ROUTERS.md is stale — run 'pnpm docs:update' and commit the result.\" && exit 1)",
    "setup": "bash scripts/setup-dev.sh",
    "check:file-size": "bash scripts/check-file-size.sh",
    "check:known-diffs": "tsx scripts/check-known-diffs.ts",
    "release": "bash scripts/release.sh",
    "deploy": "bash scripts/deploy.sh",
    "analyze": "ANALYZE=true pnpm build",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:tax-params": "tsx scripts/check-tax-params.ts",
    "backup:export": "tsx scripts/export-backup.ts",
    "backup:import": "tsx scripts/import-backup.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "flatted": ">=3.4.2"
    }
  }
}
