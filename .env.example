# Every variable here reaches the container in the sample compose files
# (env_file: .env). The three left blank below are required: compose
# refuses to start, naming the variable, until each is set.
# Finish first-run setup (create the admin) before you expose the port or
# put a public proxy in front of it.

# Database — defaults to SQLite (no setup required).
# Set DATABASE_URL to a PostgreSQL connection string to use PostgreSQL.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ledgr
# SQLITE_PATH=data/ledgr.db

# docker-compose.postgres.yml only: the bundled database's password
# (required there; it builds DATABASE_URL from it).
# POSTGRES_PASSWORD=

# Where the migrator writes its pre-upgrade backup (default /app/data, the
# data volume). Point it at a mounted directory when /app/data isn't one.
# LEDGR_BACKUP_DIR=/backups

# Server time zone fallback. Ledgr's server date math (year-end snapshots,
# paycheck and budget dates, daily syncs) runs in the household time zone
# set in Settings → General → Household — an admin's browser fills it in on
# first visit. TZ applies only until that's set (default UTC). The browser
# UI always reads the viewer's own local time zone.
# TZ=America/Chicago

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# Cron job authentication — required in production (startup fails without it)
# Generate with: openssl rand -base64 32
CRON_SECRET=

# At-rest encryption key for budget API credentials (YNAB / Actual).
# Required in production; startup fails without it. 32-byte base64 value.
# Generate with: openssl rand -base64 32
# Not required when DEMO_ONLY=true.
ENCRYPTION_KEY=

# `next dev` only: skip sign-in and give every request an admin session
# (without it, a read-only viewer). Refused in production builds.
# ALLOW_DEV_MODE=true

# Optional: Authentik OIDC provider (omit to sign in with local admins only)
# AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/ledgr
# AUTH_AUTHENTIK_ID=your_client_id
# AUTH_AUTHENTIK_SECRET=your_client_secret

# Optional: Demo-only mode (no login, read-only, profile chooser)
# DEMO_ONLY=true

# Optional: SSRF allowlist for Actual Budget server URLs.
# Comma-separated list of hosts allowed to bypass the private-IP block.
# Only needed if your Actual Budget server runs on a private network.
# ALLOWED_ACTUAL_HOSTS=actual.internal.example.com,10.0.0.5

# Budget API credentials (YNAB / Actual Budget) are NOT configured via
# env vars. Sign in as an admin and set them up in Settings → Integrations;
# values are encrypted at rest with ENCRYPTION_KEY before being stored.
