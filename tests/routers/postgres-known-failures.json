  "reasons": {
    "decimal": "PostgreSQL returns numeric text at the column's scale ('300.00', '0.500000'); the test pins SQLite's ('300', '0.5')",
    "cascade": "an earlier test in its describe failed on PostgreSQL (decimal text) before saving the id this one uses",
    "sqlite-db": "the test hands its SQLite-shaped db, not rawDb, to a server function that takes PostgreSQL's path",
    "check": "PostgreSQL's contribution_accounts_parent_cat_check refuses the row the test seeds directly; SQLite's schema has no such CHECK",
    "jsonb-string": "a string setting that reads as JSON ('42') comes back parsed (42) on PostgreSQL: node-postgres parses jsonb, then drizzle's jsonb column parses the string again"
