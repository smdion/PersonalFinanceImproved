# dependencies
node_modules

# build
.next/
tsconfig.tsbuildinfo
next-env.d.ts

# environment / secrets
.env
.env.local
.env.*.local
.env.deploy

# dev scratch (not committed)
.scratch/

# test artifacts
test-results/
playwright-report/
coverage/
tests/.tmp/
.vitest-localstorage.json*

# Claude Code plugin/skill/settings state -- local tooling, not project
# files; untracked here trips scripts/release.sh + scripts/deploy.sh's
# clean-tree check the same way an empty data/ dir does below.
.claude/settings.local.json
.claude/skills/
.claude/worktrees/
.github/skills/
.github/agents/
.github/hooks/

# artifacts
*.db
# esbuild-bundled worker (pnpm build:mc-worker) — generated, same as db-migrate.js
/monte-carlo-worker.js
# Local SQLite scratch (auto-created by db-migrate.ts when DATABASE_URL
# is unset; contains ledgr.db + pre-migration backups). The *.db pattern
# catches the files but git still reports the empty dir as untracked,
# which trips scripts/release.sh + scripts/deploy.sh's clean-tree check.
data/