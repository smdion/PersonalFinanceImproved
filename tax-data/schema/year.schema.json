{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledgr tax data — one year",
  "description": "Generated by `pnpm tax-data:schema` from src/lib/config/tax-limit-keys.ts — don't edit by hand. Conventions: tax-data/README.md.",
  "type": "object",
  "required": ["revision", "source", "sources", "limits", "withholding"],
  "properties": {
    "$schema": { "type": "string" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump when this year's figures change."
    },
    "source": { "$ref": "#/$defs/source" },
    "notes": { "type": "string" },
    "sources": {
      "type": "object",
      "description": "Each citation the year uses → a link to it.",
      "additionalProperties": { "type": "string", "pattern": "^https://" }
    },
    "limits": {
      "type": "object",
      "properties": {
        "401k_employee_limit": {
          "$ref": "#/$defs/limit",
          "description": "Annual limit (401k; inflation-indexed, currency)"
        },
        "401k_catchup_limit": {
          "$ref": "#/$defs/limit",
          "description": "Catch-up (50+) (401k; inflation-indexed, currency)"
        },
        "401k_super_catchup_limit": {
          "$ref": "#/$defs/limit",
          "description": "Super catch-up (60–63) (401k; inflation-indexed, currency)"
        },
        "401k_total_additions_limit": {
          "$ref": "#/$defs/limit",
          "description": "Total additions (employee + employer) (401k; inflation-indexed, currency)"
        },
        "ira_limit": {
          "$ref": "#/$defs/limit",
          "description": "Annual limit (IRA; inflation-indexed, currency)"
        },
        "ira_catchup_limit": {
          "$ref": "#/$defs/limit",
          "description": "Catch-up (50+) (IRA; inflation-indexed, currency)"
        },
        "hsa_individual_limit": {
          "$ref": "#/$defs/limit",
          "description": "Self-only (HSA; inflation-indexed, currency)"
        },
        "hsa_family_limit": {
          "$ref": "#/$defs/limit",
          "description": "Family (HSA; inflation-indexed, currency)"
        },
        "hsa_catchup_limit": {
          "$ref": "#/$defs/limit",
          "description": "Catch-up (55+) (HSA; fixed by law, currency)"
        },
        "standard_deduction_mfj": {
          "$ref": "#/$defs/limit",
          "description": "Married filing jointly (Standard deduction; inflation-indexed, currency)"
        },
        "standard_deduction_single": {
          "$ref": "#/$defs/limit",
          "description": "Single (Standard deduction; inflation-indexed, currency)"
        },
        "standard_deduction_hoh": {
          "$ref": "#/$defs/limit",
          "description": "Head of household (Standard deduction; inflation-indexed, currency)"
        },
        "additional_std_deduction_65_married": {
          "$ref": "#/$defs/limit",
          "description": "Age 65+ addition, married (per spouse) (Standard deduction; inflation-indexed, currency)"
        },
        "additional_std_deduction_65_unmarried": {
          "$ref": "#/$defs/limit",
          "description": "Age 65+ addition, single / head of household (Standard deduction; inflation-indexed, currency)"
        },
        "obbba_senior_deduction_per_person": {
          "$ref": "#/$defs/limit",
          "description": "Per person 65+ (Senior deduction (2025–2028); fixed by law, currency)"
        },
        "obbba_senior_deduction_phaseout_start_mfj": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out starts, married filing jointly (Senior deduction (2025–2028); fixed by law, currency)"
        },
        "obbba_senior_deduction_phaseout_start_unmarried": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out starts, single / head of household (Senior deduction (2025–2028); fixed by law, currency)"
        },
        "obbba_senior_deduction_phaseout_rate": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out rate (Senior deduction (2025–2028); rate set by law, percent)"
        },
        "obbba_senior_deduction_sunset_year": {
          "$ref": "#/$defs/limit",
          "description": "Last year available (Senior deduction (2025–2028); fixed by law, year)"
        },
        "ss_wage_base": {
          "$ref": "#/$defs/limit",
          "description": "Social Security wage base (Social Security & Medicare; inflation-indexed, currency)"
        },
        "fica_ss_rate": {
          "$ref": "#/$defs/limit",
          "description": "Social Security rate (Social Security & Medicare; rate set by law, percent)"
        },
        "fica_medicare_rate": {
          "$ref": "#/$defs/limit",
          "description": "Medicare rate (Social Security & Medicare; rate set by law, percent)"
        },
        "fica_medicare_surtax_rate": {
          "$ref": "#/$defs/limit",
          "description": "Additional Medicare rate (Social Security & Medicare; rate set by law, percent)"
        },
        "fica_medicare_surtax_threshold": {
          "$ref": "#/$defs/limit",
          "description": "Additional Medicare: employer withholds above (Social Security & Medicare; fixed by law, currency)"
        },
        "fica_medicare_surtax_liability_mfj": {
          "$ref": "#/$defs/limit",
          "description": "Additional Medicare: owed above, married filing jointly (Social Security & Medicare; fixed by law, currency)"
        },
        "fica_medicare_surtax_liability_single": {
          "$ref": "#/$defs/limit",
          "description": "Additional Medicare: owed above, single (Social Security & Medicare; fixed by law, currency)"
        },
        "fica_medicare_surtax_liability_hoh": {
          "$ref": "#/$defs/limit",
          "description": "Additional Medicare: owed above, head of household (Social Security & Medicare; fixed by law, currency)"
        },
        "roth_ira_phaseout_start_mfj": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out starts, married filing jointly (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "roth_ira_phaseout_end_mfj": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out ends, married filing jointly (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "roth_ira_phaseout_start_single": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out starts, single (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "roth_ira_phaseout_end_single": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out ends, single (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "roth_ira_phaseout_start_hoh": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out starts, head of household (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "roth_ira_phaseout_end_hoh": {
          "$ref": "#/$defs/limit",
          "description": "Phase-out ends, head of household (Roth IRA eligibility; inflation-indexed, currency)"
        },
        "hdhp_min_deductible_self": {
          "$ref": "#/$defs/limit",
          "description": "Minimum deductible, self-only (HSA eligibility (HDHP); inflation-indexed, currency)"
        },
        "hdhp_min_deductible_family": {
          "$ref": "#/$defs/limit",
          "description": "Minimum deductible, family (HSA eligibility (HDHP); inflation-indexed, currency)"
        },
        "qcd_annual_limit": {
          "$ref": "#/$defs/limit",
          "description": "Most an IRA can give to charity, per person (Charitable distributions (QCD); inflation-indexed, currency)"
        },
        "supplemental_tax_rate": {
          "$ref": "#/$defs/limit",
          "description": "Bonus (supplemental) withholding rate (Withholding; rate set by law, percent)"
        }
      },
      "additionalProperties": false
    },
    "withholding": {
      "type": "object",
      "required": ["source", "tables"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "tables": {
          "type": "object",
          "required": ["MFJ", "Single", "HOH"],
          "properties": {
            "MFJ": {
              "type": "object",
              "required": ["standard", "checkbox"],
              "properties": {
                "standard": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "checkbox": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "Single": {
              "type": "object",
              "required": ["standard", "checkbox"],
              "properties": {
                "standard": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "checkbox": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "HOH": {
              "type": "object",
              "required": ["standard", "checkbox"],
              "properties": {
                "standard": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "checkbox": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["threshold", "baseWithholding", "rate"],
                    "properties": {
                      "threshold": { "type": "number", "minimum": 0 },
                      "baseWithholding": { "type": "number", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "description": "Values this section shipped with before (corrections)."
        },
        "exception": {
          "type": "object",
          "description": "Outside the year-to-year bounds on purpose — say why and cite it.",
          "required": ["reason", "source"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ltcg": {
      "type": "object",
      "required": ["source", "brackets"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "brackets": {
          "type": "object",
          "required": ["MFJ", "Single", "HOH"],
          "properties": {
            "MFJ": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["threshold", "rate"],
                "properties": {
                  "threshold": {
                    "type": ["number", "null"],
                    "description": "null = the top bracket (no upper end)."
                  },
                  "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "Single": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["threshold", "rate"],
                "properties": {
                  "threshold": {
                    "type": ["number", "null"],
                    "description": "null = the top bracket (no upper end)."
                  },
                  "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "HOH": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["threshold", "rate"],
                "properties": {
                  "threshold": {
                    "type": ["number", "null"],
                    "description": "null = the top bracket (no upper end)."
                  },
                  "rate": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "description": "Values this section shipped with before (corrections)."
        },
        "exception": {
          "type": "object",
          "description": "Outside the year-to-year bounds on purpose — say why and cite it.",
          "required": ["reason", "source"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "irmaa": {
      "type": "object",
      "required": ["source", "brackets"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "brackets": {
          "type": "object",
          "required": ["MFJ", "Single", "HOH"],
          "properties": {
            "MFJ": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["magiThreshold", "annualSurcharge"],
                "properties": {
                  "magiThreshold": { "type": "number", "minimum": 0 },
                  "annualSurcharge": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Per person, a year: Part B + Part D adjustments × 12."
                  }
                },
                "additionalProperties": false
              }
            },
            "Single": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["magiThreshold", "annualSurcharge"],
                "properties": {
                  "magiThreshold": { "type": "number", "minimum": 0 },
                  "annualSurcharge": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Per person, a year: Part B + Part D adjustments × 12."
                  }
                },
                "additionalProperties": false
              }
            },
            "HOH": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["magiThreshold", "annualSurcharge"],
                "properties": {
                  "magiThreshold": { "type": "number", "minimum": 0 },
                  "annualSurcharge": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Per person, a year: Part B + Part D adjustments × 12."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "description": "Values this section shipped with before (corrections)."
        },
        "exception": {
          "type": "object",
          "description": "Outside the year-to-year bounds on purpose — say why and cite it.",
          "required": ["reason", "source"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fpl": {
      "type": "object",
      "required": ["source", "amounts"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "amounts": {
          "type": "object",
          "required": ["1", "2", "3", "4", "5", "6", "7", "8"],
          "propertyNames": { "pattern": "^[1-8]$" },
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "supersedes": {
          "description": "Values this section shipped with before (corrections)."
        },
        "exception": {
          "type": "object",
          "description": "Outside the year-to-year bounds on purpose — say why and cite it.",
          "required": ["reason", "source"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "One or more citations joined by \"; \" — each a key in the year's `sources`."
    },
    "limit": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "notes": {
          "type": "string",
          "description": "Plain words about the figure (not a citation)."
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Values this key shipped with before (corrections)."
        },
        "exception": {
          "type": "object",
          "description": "Outside the year-to-year bounds on purpose — say why and cite it.",
          "required": ["reason", "source"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
